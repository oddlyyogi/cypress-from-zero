    "cypress-mochawesome-reporter": "^5.0.0",
    "cypress-multi-reporters": "^2.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-cypress": "^7.0.4",
    "mocha-junit-reporter": "^2.2.1",
